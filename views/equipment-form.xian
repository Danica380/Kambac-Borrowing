{{> head}}
<body class="app-page equipment-page equipment-form-page">
  <div class="app-layout">
    {{> sidebar}}
    <main class="app-main">
      <header class="page-header">
        <div>
          <h1>{{title}}</h1>
        </div>
      </header>

      {{#each errors}}
        <p class="notice notice-error" role="alert">{{this}}</p>
      {{/each}}
      {{#each error_msg}}
        <p class="notice notice-error" role="alert">{{this}}</p>
      {{/each}}

      <section class="inventory-panel form-panel">
        <form class="equipment-form" method="POST" enctype="multipart/form-data" action="{{#if editing}}/equipment/{{itemId}}{{else}}/equipment{{/if}}">
          <div class="form-grid">
            <label class="form-field">
              <span>Equipment name <span class="required-mark">*</span></span>
              <input type="text" name="name" value="{{form.name}}" maxlength="120" required>
            </label>
            <label class="form-field">
              <span>Category <span class="required-mark">*</span></span>
              <select name="category" required>
                <option value="" disabled {{#unless form.category}}selected{{/unless}}>Pumili ng kategorya</option>
                {{#each categories}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label class="form-field">
              <span>Quantity <span class="required-mark">*</span></span>
              <input type="number" name="totalQuantity" value="{{form.totalQuantity}}" min="{{borrowedQuantity}}" max="2147483647" step="1" required>
            </label>
            <label class="form-field">
              <span>Date added</span>
              <input type="date" name="dateAdded" value="{{dateAdded}}" readonly aria-describedby="date-added-help">
              <small id="date-added-help">Awtomatikong itinatala ang petsa kapag idinagdag ang kagamitan.</small>
            </label>
            <label class="form-field form-field-wide">
              <span>Equipment photo {{#unless editing}}<span class="required-mark">*</span>{{else}}<span class="optional-label">(optional)</span>{{/unless}}</span>
              <div class="equipment-photo-preview-container">
                <img class="equipment-photo-preview" data-photo-preview alt="Preview of {{form.name}}" {{#if photoPath}}src="{{photoPath}}"{{else}}hidden{{/if}}>
                <div class="equipment-photo-placeholder" data-photo-placeholder {{#if photoPath}}hidden{{/if}}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                  <span>Image preview will appear here</span>
                </div>
              </div>
              <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" {{#unless editing}}required{{/unless}}>
              <small>JPEG, PNG, or WebP; maximum file size 20 MB{{#if editing}}. Upload a new photo to replace the current one{{/if}}.</small>
            </label>
          </div>

          {{#if editing}}
            <p class="form-inventory-note">Currently borrowed: <strong>{{borrowedQuantity}}</strong>. Borrowed quantity is read-only and is reserved for borrowing/return records.</p>
          {{else}}
            <p class="form-inventory-note">New items start with zero borrowed quantity. The date added is recorded automatically.</p>
          {{/if}}
          <div class="form-actions">
            <a class="secondary-button" href="{{backUrl}}">Cancel</a>
            <button class="primary-button" type="submit">{{#if editing}}Save changes{{else}}Add equipment{{/if}}</button>
          </div>
        </form>
      </section>
    </main>
  </div>
{{> footer}}

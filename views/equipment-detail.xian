{{> head}}
<body class="app-page equipment-page">
  <div class="app-layout">
    {{> sidebar}}
    <main class="app-main">
      {{#each success_msg}}
        <p class="notice notice-success" role="status">{{this}}</p>
      {{/each}}
      {{#each error_msg}}
        <p class="notice notice-error" role="alert">{{this}}</p>
      {{/each}}
      <header class="page-header detail-header">
        <div>
          <a class="back-link" href="/equipment">← Equipment inventory</a>
          <h1>{{item.name}}</h1>
          <p class="muted-text">{{item.category}} · {{item.statusLabel}}</p>
        </div>
        <a class="secondary-button" href="/equipment/{{item.id}}/edit">Edit item</a>
      </header>

      <section class="inventory-panel detail-panel" aria-labelledby="item-details-title">
        <div class="panel-heading"><h2 id="item-details-title">Equipment details</h2></div>
        <dl class="detail-grid">
          <div><dt>Category</dt><dd>{{item.category}}</dd></div>
          <div><dt>Total quantity</dt><dd>{{item.totalQuantity}}</dd></div>
          <div><dt>Available quantity</dt><dd>{{item.availableQuantity}}</dd></div>
          <div><dt>Borrowed quantity</dt><dd>{{item.borrowedQuantity}}</dd></div>
          <div><dt>Condition</dt><dd>{{item.conditionLabel}}</dd></div>
          <div><dt>Date added</dt><dd>{{item.createdDate}}</dd></div>
          <div><dt>Last updated</dt><dd>{{item.updatedDate}}</dd></div>
          <div class="detail-wide"><dt>Description</dt><dd>{{#if item.description}}{{item.description}}{{else}}No description provided.{{/if}}</dd></div>
        </dl>
        <section class="borrowing-section" aria-labelledby="borrow-equipment-title">
          <div class="borrowing-section-heading">
            <div>
              <h2 id="borrow-equipment-title">Borrow equipment</h2>
              <p class="muted-text">Record who is borrowing this item and when it is due back.</p>
            </div>
          </div>
          {{#if item.canBorrow}}
            <form class="borrow-form" method="POST" action="/equipment/{{item.id}}/borrow">
              <label class="borrow-field">
                <span>Borrower's full name</span>
                <input type="text" name="borrowerName" maxlength="120" autocomplete="name" required>
              </label>
              <label class="borrow-field">
                <span>Quantity <small>({{item.availableQuantity}} available)</small></span>
                <input type="number" name="quantity" min="1" max="{{item.availableQuantity}}" step="1" value="1" required>
              </label>
              <label class="borrow-field">
                <span>Expected return date</span>
                <input type="date" name="dueDate" min="{{todayDate}}" required>
              </label>
              <label class="borrow-field borrow-field-wide">
                <span>Purpose / notes <small>(optional)</small></span>
                <textarea name="purpose" rows="3" maxlength="2000"></textarea>
              </label>
              <div class="borrow-form-actions">
                <button class="primary-button" type="submit">Record borrowing</button>
              </div>
            </form>
          {{else}}
            <p class="borrow-unavailable">
              {{#if item.isActive}}
                {{#if item.availableQuantity}}This equipment condition does not allow borrowing.{{else}}No units are currently available to borrow.{{/if}}
              {{else}}
                Archived equipment cannot be borrowed.
              {{/if}}
            </p>
          {{/if}}
        </section>
        <div class="history-notice">
          <h3>Borrowing history</h3>
          {{#if borrowings.length}}
            <div class="table-scroll borrowing-table-scroll">
              <table class="inventory-table borrowing-table">
                <thead>
                  <tr>
                    <th scope="col">Borrower</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Borrowed</th>
                    <th scope="col">Due date</th>
                    <th scope="col">Status</th>
                    <th scope="col">Purpose / notes</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                  </tr>
                </thead>
                <tbody>
                  {{#each borrowings}}
                    <tr>
                      <td>{{borrowerName}}</td>
                      <td>{{quantity}}</td>
                      <td>{{borrowedAt}}</td>
                      <td>{{dueDate}}</td>
                      <td>{{#if isReturned}}Returned ({{returnedAt}}){{else}}On loan{{/if}}</td>
                      <td>{{#if purpose}}{{purpose}}{{else}}—{{/if}}</td>
                      <td>
                        {{#unless isReturned}}
                          <form method="POST" action="/equipment/{{../item.id}}/borrowings/{{id}}/return">
                            <button class="return-button" type="submit">Record return</button>
                          </form>
                        {{/unless}}
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <p class="muted-text">No borrowing records yet.</p>
          {{/if}}
        </div>
        <form class="status-form" method="POST" action="/equipment/{{item.id}}/status">
          {{#if item.isActive}}
            <p class="muted-text">Archiving keeps the item record and its quantity history; it will no longer appear in active inventory.</p>
            <button class="danger-button" type="submit" name="action" value="archive">Archive item</button>
          {{else}}
            <p class="muted-text">This item is archived and excluded from active inventory.</p>
            <button class="secondary-button" type="submit" name="action" value="activate">Activate item</button>
          {{/if}}
        </form>
      </section>
    </main>
  </div>
{{> footer}}
